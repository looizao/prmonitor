{
  "name": "pr-monitor",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 9000",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src e2e",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:extension": "pnpm build && playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm test:package && pnpm test:release",
    "qa:autonomous": "pnpm check && pnpm test:extension",
    "test:live": "vitest run --config vitest.live.config.ts",
    "package": "node scripts/package.mjs",
    "format": "prettier --write .",
    "test:package": "node --test scripts/package.test.mjs",
    "test:release": "node --test scripts/release.test.mjs"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.0",
    "assert-never": "^1.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.24",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@playwright/test": "^1.58.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.18",
    "oxlint": "^1.43.0",
    "prettier": "^3.8.0"
  }
}
